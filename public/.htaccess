# Apache front controller for the public document root.
# The application itself lives one level above this directory.

Options -Indexes
DirectoryIndex index.php

# Pass the bearer token to PHP when Apache/FastCGI strips the header by default.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /mcp is an alias for the real endpoint.
    RewriteRule ^mcp/?$ mcp.php [L,QSA]

    # Existing files and directories are served directly. Everything else
    # (/, /ru.html, /sitemap.xml, ...) goes through the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Never expose dotfiles or editor/backup debris from the document root.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|dist|orig|swp|tmp|log|env))$">
    Require all denied
</FilesMatch>

# The PHP front controllers send these too; this covers static assets.
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Runtime state: writes to the server, never overwritten by a deploy
app/content/site.json
app/content/backups/
app/content/.audit.jsonl
app/content/*.lock
app/content/*.tmp

# Rendered HTML cache
app/cache/

# Secrets: the token lives in the private app directory, never in public/
app/bio.token
app/bio.token.lock
bio.token

# Local tooling
node_modules/
package-lock.json
app/.env

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
